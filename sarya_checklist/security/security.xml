<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Custom Module Category -->
        <record id="module_category_checklist" model="ir.module.category">
            <field name="name">Checklist</field>
            <field name="sequence" eval="10"/>
        </record>

        <!-- Checklist User -->
        <record id="group_checklist_user" model="res.groups">
            <field name="name">Checklist User</field>
            <field name="category_id" ref="module_category_checklist"/>
        </record>

        <!-- Checklist Manager -->
        <record id="group_checklist_manager" model="res.groups">
            <field name="name">Checklist Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_checklist_user'))]"/>
            <field name="category_id" ref="module_category_checklist"/>
        </record>

        <!-- Checklist Admin -->
        <record id="group_checklist_admin" model="res.groups">
            <field name="name">Checklist Admin</field>
            <field name="implied_ids" eval="[(4, ref('group_checklist_manager'))]"/>
            <field name="category_id" ref="module_category_checklist"/>
        </record>


<!--        Record Rules for Outlet Checklist Model-->

        <record id="rule_outlet_checklist_manager" model="ir.rule">
            <field name="name">Outlet Checklist - Manager Full Access</field>
            <field name="model_id" ref="model_outlet_checklist"/>
            <field name="groups" eval="[(4, ref('group_checklist_manager'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>


        <record id="rule_outlet_checklist_admin" model="ir.rule">
            <field name="name">Outlet Checklist - Admin Full Access</field>
            <field name="model_id" ref="model_outlet_checklist"/>
            <field name="groups" eval="[(4, ref('group_checklist_admin'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>



        <record id="rule_checklist_user" model="ir.rule">
            <field name="name">Checklist - Responsible Only</field>
            <field name="model_id" ref="model_outlet_checklist"/>
            <field name="groups" eval="[(4, ref('group_checklist_user'))]"/>
            <field name="domain_force">[('responsible_user_ids', 'in', [user.id])]</field>
        </record>



    </data>
</odoo>
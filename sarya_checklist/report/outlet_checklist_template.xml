<odoo>

<template id="outlet_checklist_template">
    <t t-call="web.external_layout">
        <t t-set="doc" t-value="doc"/>

        <div class="page">

            <!-- HEADER -->
            <h2 style="text-align:center;">
                SOP CHECKLIST
            </h2>

            <table class="table table-sm o_main_table">
                <tr>
                    <td><strong>SOP Name</strong></td>
                    <td><span t-esc="doc.name"/></td>
                    <td><strong>Outlet</strong></td>
                    <td><span t-esc="doc.outlet_id.name"/></td>
                </tr>
                <tr>
                    <td><strong>Responsible</strong></td>
                    <td><span t-esc="doc.responsible_user_id.name"/></td>
                    <td><strong>Status</strong></td>
                    <td><span t-esc="doc.state"/></td>
                </tr>
                <tr>
                    <td><strong>Started On</strong></td>
                    <td>
                        <span t-esc="doc.start_on"/>
                        (<span t-esc="doc.start_by.name"/>)
                    </td>
                    <td><strong>Completed On</strong></td>
                    <td>
                        <span t-esc="doc.completed_on"/>
                        (<span t-esc="doc.completed_by.name"/>)
                    </td>
                </tr>
            </table>

            <br/>

            <!-- CHECKLIST LINES -->
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th style="width:45%">Description</th>
                        <th style="width:10%">Done</th>
                        <th style="width:20%">Remark</th>
                        <th style="width:25%">Attachments</th>
                    </tr>
                </thead>

                <tbody>
                    <t t-foreach="doc.line_ids" t-as="line">

                        <!-- SECTION -->
                        <tr t-if="line.display_type == 'section'">
                            <td colspan="4"
                                style="background:#e3f2fd;font-weight:bold;">
                                <span t-esc="line.name"/>
                            </td>
                        </tr>

                        <!-- NOTE -->
                        <tr t-if="line.display_type == 'note'">
                            <td colspan="4"
                                style="background:#f5f5f5;font-style:italic;">
                                <span t-esc="line.name"/>
                            </td>
                        </tr>

                        <!-- CHECKLIST LINE -->
                        <tr t-if="line.display_type == 'line'">
                            <td>
                                <span t-esc="line.name"/>
                            </td>

                            <td style="text-align:center;">
                                <t t-if="line.is_done">✔</t>
                                <t t-else>✖</t>
                            </td>

                            <td>
                                <span t-esc="line.remark"/>
                            </td>

                            <td>
                                <t t-foreach="line.attachment_ids" t-as="att">
                                    <img t-att-src="'data:image/png;base64,%s' % att.datas"
                                         style="max-height:80px;margin:4px;"/>
                                </t>
                            </td>
                        </tr>

                    </t>
                </tbody>
            </table>

        </div>
    </t>
</template>

</odoo>

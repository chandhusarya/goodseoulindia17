<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ACTION -->
    <record id="action_checklist_config" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">checklist.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- TREE -->
    <record id="view_checklist_config_tree" model="ir.ui.view">
        <field name="name">checklist.config.tree</field>
        <field name="model">checklist.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="frequency"/>
                <field name="validity_hours"/>
                <field name="last_generated_on"/>
            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_checklist_config_form" model="ir.ui.view">
        <field name="name">checklist.config.form</field>
        <field name="model">checklist.config</field>
        <field name="arch" type="xml">
            <form string="Checklist Template">
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="frequency"/>
                        <field name="validity_hours"/>
                        <field name="responsible_master_id"/>
                        <field name="outlet_ids" widget="many2many_tags"/>
                        <field name="last_generated_on" readonly="0"/>
                    </group>

                    <notebook>
                        <page string="Checklist Lines">
                            <field name="line_ids">
                                <tree editable="bottom" decoration-muted="display_type == 'note'" class="o_list_small_width">
                                    <control>
                                        <create string="Add a line" context="{'default_display_type': 'line'}"/>
                                        <create string="Add a section"
                                                context="{'default_display_type': 'section'}"/>
                                        <create string="Add a note"
                                                context="{'default_display_type': 'note'}"/>
                                    </control>

                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="True"/>
                                    <field name="name" widget="section_and_note_text"/>
                                    <field name="attachment_required"
                                           invisible="display_type != 'line'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>



    <record id="action_outlet_checklist" model="ir.actions.act_window">
        <field name="name">Outlet Checklists</field>
        <field name="res_model">outlet.checklist</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">
            {
                'search_default_filter_new': 1
            }
        </field>
    </record>

    <record id="view_outlet_checklist_kanban" model="ir.ui.view">
        <field name="name">outlet.checklist.kanban</field>
        <field name="model">outlet.checklist</field>
        <field name="arch" type="xml">
            <kanban>
                <!-- REQUIRED -->
                <field name="id"/>
                <field name="name"/>
                <field name="outlet_id"/>
                <field name="responsible_user_ids"/>
                <field name="valid_till"/>
                <field name="state"/>

                <templates>
                    <t t-name="kanban-box">
                        <!-- CLICK HANDLER -->
                        <a type="open" class="o_kanban_record o_kanban_clickable">
                            <div class="card mb-2">
                                <div class="o_kanban_card_header">
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </div>

                                <div class="o_kanban_card_body">
                                    <div>
                                        <strong>Outlet:</strong>
                                        <field name="outlet_id"/>
                                    </div>
                                    <div>
                                        <strong>Responsible:</strong>
                                        <field name="responsible_user_ids"/>
                                    </div>
                                    <div>
                                        <strong>Valid Till:</strong>
                                        <field name="valid_till"/>
                                    </div>
                                </div>

                                <div class="o_kanban_card_footer">
                                    <field name="state" widget="label_selection"/>
                                </div>
                            </div>
                        </a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- TREE -->
    <record id="view_outlet_checklist_tree" model="ir.ui.view">
        <field name="name">outlet.checklist.tree</field>
        <field name="model">outlet.checklist</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_expired"
                  decoration-muted="state=='new'"
                  decoration-warning="state=='in_progress'"
                  decoration-success="state=='completed'">
                <field name="is_expired" column_invisible="1"/>
                <field name="name"/>
                <field name="outlet_id"/>
                <field name="responsible_user_ids"/>
                <field name="state"/>
                <field name="valid_till"/>
            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_outlet_checklist_form" model="ir.ui.view">
        <field name="name">outlet.checklist.form</field>
        <field name="model">outlet.checklist</field>
        <field name="arch" type="xml">
            <form string="Outlet Checklist">
                <header>

                    <button name="action_start"
                            type="object"
                            string="Start"
                            invisible="state != 'new'"
                            class="btn-primary"/>

                    <button name="action_complete"
                            type="object"
                            string="Complete"
                            invisible="state != 'in_progress'"
                            class="btn-success"/>

                    <button name="%(action_outlet_checklist_report)d"
                        string="Print PDF"
                        type="action"
                        class="btn-secondary"
                        invisible="state != 'completed'"/>


                    <field name="state" widget="statusbar"/>

                </header>

                <sheet>

                    <group>
                        <field name="name" readonly="1"/>
                        <field name="outlet_id" readonly="1"/>
                        <field name="responsible_user_ids" readonly="1" widget="many2many_tags"/>
                        <field name="valid_till" readonly="1"/>
                        <field name="employee_id" required="1" readonly="state == 'completed'"/>
                    </group>

                    <notebook>
                        <page string="Checklist">
                            <field name="line_ids" readonly="state == 'completed'">
                                <tree editable="bottom" limit="200">
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="True"/>
                                    <field name="name" readonly="1" widget="section_and_note_text"/>

                                    <field name="is_done"
                                           invisible="display_type != 'line'"/>
                                    <field name="remark"
                                           invisible="display_type != 'line'"/>

                                    <field name="attachment_ids"
                                           widget="many2many_binary"
                                           options="{
                                               'accept': 'image/*',
                                               'capture': 'environment',
                                               'no_open': true
                                           }"
                                           invisible="display_type != 'line'"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Audit">
                            <group>
                                <group>
                                    <field name="completed_on" readonly="1"/>
                                    <field name="completed_by" readonly="1"/>
                                    <field name="started_on" readonly="1"/>
                                    <field name="started_by" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_outlet_checklist_search" model="ir.ui.view">
        <field name="name">outlet.checklist.search</field>
        <field name="model">outlet.checklist</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="state"/>
                <field name="outlet_id"/>
                <!-- Filters -->
                <filter string="New"
                        name="filter_new"
                        domain="[('state','=','new')]"/>
                <filter string="In Progress"
                        name="filter_in_progress"
                        domain="[('state','=','in_progress')]"/>
                <filter string="Completed"
                        name="filter_completed"
                        domain="[('state','=','completed')]"/>
                <!-- Group By shortcuts -->
                <group string="Group By">
                    <filter name="group_state" string="State"
                            context="{'group_by':'state'}"/>
                    <filter name="group_outlet" string="Outlet"
                            context="{'group_by':'outlet_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--    Stock Count List view-->

        <record id="stock_count_list_view" model="ir.ui.view">
            <field name="name">stock.count.list.view</field>
            <field name="model">stock.count</field>
            <field name="arch" type="xml">
                <tree decoration-muted="state == 'cancel'">
                    <field name="date"/>
                    <field name="name"/>
                    <field name="pos_config_id"/>
                    <field name="location_id"/>
                    <field name="state"/>
                    <field name="company_id" optional="hide"/>
                </tree>
            </field>
        </record>

        <!--    Stock Count form view    -->

        <record id="stock_count_form_view" model="ir.ui.view">
            <field name="name">stock.count.form.view</field>
            <field name="model">stock.count</field>
            <field name="arch" type="xml">
                <form string="Stock Count form">
                    <header>
                        <button name="action_start" invisible="state != 'draft'" string="Start Inventory" type="object"
                                class="oe_highlight" groups="stock.group_stock_user"/>
                        <button name="action_send_for_approval" invisible="state != 'progress'"
                                string="Send For Approval"
                                type="object"
                                class="oe_highlight" groups="stock.group_stock_user"/>
                        <button name="action_approve" invisible="state != 'send_for_approval' or not is_approve_user"
                                string="Approve"
                                type="object"
                                class="oe_highlight" groups="sarya_stock_count.stock_count_approve_manager_group"/>
                        <button name="action_reject" invisible="state != 'send_for_approval' or not is_approve_user"
                                string="Reject"
                                type="object"
                                class="oe_highlight" groups="sarya_stock_count.stock_count_approve_manager_group"/>
                        <button name="action_validate" invisible="state != 'approved'" string="Validate Inventory"
                                type="object"
                                class="oe_highlight" groups="sarya_stock_count.stock_count_approve_manager_group"/>
                        <button name="action_draft" invisible="state not in ('cancel', 'rejected')"
                                string="Set to Draft"
                                type="object"/>
                        <button name="action_cancel" invisible="state not in ('progress', 'approved')"
                                string="Cancel Inventory"
                                type="object"/>
                        <field name="state" clickable="1" widget="statusbar" statusbar_visible="draft,progress,done"/>
                    </header>
                    <sheet>

                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" required="1" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="pos_config_id"
                                       options="{'no_create_edit': True, 'no_create': True}"
                                       required="1"
                                       domain="[('terminal_type', '=', 'primary')]"
                                       readonly="state != 'draft'"/>
                                <field name="location_id" domain="[('usage', '=', 'internal')]"
                                       options="{'no_create_edit': True, 'no_create': True}" required="1"
                                       groups="stock.group_stock_multi_locations" readonly="state != 'draft'"/>
                                <field name="stock_count_config_id"
                                       options="{'no_create_edit': True, 'no_create': True}" readonly="state != 'draft'"/>
                                <field name="brand_ids" widget="many2many_tags" invisible="1"
                                       options="{'no_create_edit': True, 'no_create': True}" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="is_approve_user" invisible="1"/>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="approved_date" invisible="not approved_date"/>
                                <field name="approved_by" invisible="not approved_by"/>
                                <field name="validated_date" invisible="not validated_date"/>
                                <field name="company_id" groups="base.group_multi_company"
                                       options="{'no_create_edit': True, 'no_create': True}"/>
                            </group>
                        </group>
                        <notebook invisible="state == 'draft'">
                            <page string="Inventory Count Session">
                                <button name="action_reset_counted_qty" invisible="1"
                                        string="⇒ Set Counted quantities to 0"
                                        type="object" class="oe_link oe_right" groups="stock.group_stock_user"/>
                                <br/>
                                <button name="action_set_is_counted_qty_entered" invisible="1"
                                        string="⇒ Set Is Real Qty Entered As True"
                                        type="object" class="oe_link oe_right" groups="base.group_no_one"/>
                                <field name="product_count_line_ids" string="Inventory Details" mode="kanban"
                                       readonly="state != 'progress'">
                                    <kanban class="o_kanban_mobile" create="0" delete="0">
                                        <field name="product_id" domain="[('type','=','product')]"/>
                                        <field name="location_id" domain="[('id', 'child_of', parent.location_id)]"
                                               groups="stock.group_stock_multi_locations"/>
                                        <field name="theoretical_qty" force_save="1"/>
                                        <field name="counted_qty" string="Real Quantity"/>
                                        <field name="stock_diff_quantity"/>
                                        <field name="state" invisible="True"/>
                                        <templates>
                                            <t t-name="kanban-box">
                                                <div t-attf-class="oe_kanban_global_click_edit
                                                           #{record.counted_qty.raw_value!=record.theoretical_qty.raw_value ? 'oe_kanban_color_6' : ''}
                                                           #{record.theoretical_qty.raw_value&lt;0 ? 'oe_kanban_color_2' : ''}">
                                                    <div class="row">
                                                        <div class="col-12">
                                                            <strong>
                                                                <field name='product_id'/>
                                                            </strong>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-12 text-muted">
                                                            <span>Location :
                                                                <t t-esc='record.location_id.value'/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-12 text-muted">
                                                            <span>Real Quantity :
                                                                <t t-esc='record.counted_qty.value'/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-12 text-muted">
                                                            <span>Theoretical Qty :
                                                                <t t-esc='record.theoretical_qty.value'/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-12 text-muted">
                                                            <span>Difference :
                                                                <t t-esc='record.stock_diff_quantity.value'/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                                <h3 class="oe_grey">Notes</h3>
                                <ul class="oe_grey">
                                    <li>Inventory adjustments will be made by comparing the theoretical and the checked
                                        quantities.
                                    </li>
                                </ul>
                            </page>
                            <page string="Inventory Count Recheck Session">
                                <button name="action_reset_counted_qty" invisible="1"
                                        string="⇒ Set Counted quantities to 0"
                                        type="object" class="oe_link oe_right" groups="stock.group_stock_user"/>
                                <br/>
                                <button name="action_set_is_counted_qty_entered" invisible="1"
                                        string="⇒ Set Is Real Qty Entered As True"
                                        type="object" class="oe_link oe_right" groups="base.group_no_one"/>
                                <field name="line_ids" string="Inventory Details" mode="kanban"
                                       readonly="state != 'progress'">
                                    <kanban class="o_kanban_mobile" create="0" delete="0">
                                        <field name="product_id" domain="[('type','=','product')]"/>
                                        <field name="location_id" domain="[('id', 'child_of', parent.location_id)]"
                                               groups="stock.group_stock_multi_locations"/>
                                        <field name="theoretical_qty" force_save="1"/>
                                        <field name="counted_qty" string="Real Quantity"/>
                                        <field name="stock_diff_quantity"/>
                                        <field name="state" invisible="True"/>
                                        <templates>
                                            <t t-name="kanban-box">
                                                <div t-attf-class="oe_kanban_global_click_edit
                                                           #{record.counted_qty.raw_value!=record.theoretical_qty.raw_value ? 'oe_kanban_color_6' : ''}
                                                           #{record.theoretical_qty.raw_value&lt;0 ? 'oe_kanban_color_2' : ''}">
                                                    <div class="row">
                                                        <div class="col-12">
                                                            <strong>
                                                                <field name='product_id'/>
                                                            </strong>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-12 text-muted">
                                                            <span>Location :
                                                                <t t-esc='record.location_id.value'/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-12 text-muted">
                                                            <span>Real Quantity :
                                                                <t t-esc='record.counted_qty.value'/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-12 text-muted">
                                                            <span>Theoretical Qty :
                                                                <t t-esc='record.theoretical_qty.value'/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-12 text-muted">
                                                            <span>Difference :
                                                                <t t-esc='record.stock_diff_quantity.value'/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                                <h3 class="oe_grey">Notes</h3>
                                <ul class="oe_grey">
                                    <li>Inventory adjustments will be made by comparing the theoretical and the checked
                                        quantities.
                                    </li>
                                </ul>
                            </page>
                            <page string="Stock Moves" name="stock_move" readonly="state != 'progress'">
                                <field name="stock_move_ids" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!--  Stock Count search view     -->

        <record id="stock_count_search_view" model="ir.ui.view">
            <field name="name">stock.count.search.view</field>
            <field name="model">stock.count</field>
            <field name="arch" type="xml">
                <search string="Search Name">
                    <field name="name" string="Name"/>
                    <separator/>
                    <group expand="1" string="Group By">
                        <filter string="Status" name="state" domain="[]" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!--    Stock Count action     -->

        <record id="stock_count_action" model="ir.actions.act_window">
            <field name="name">Stock Count</field>
            <field name="res_model">stock.count</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="stock_count_search_view"/>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('stock_count_list_view')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('stock_count_form_view')}),
                         ]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create New Stock Count Record.
                </p>
            </field>
        </record>

    </data>
</odoo>

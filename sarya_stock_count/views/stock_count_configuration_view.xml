<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--    Stock Count Configuration List view-->

        <record id="stock_count_config_list_view" model="ir.ui.view">
            <field name="name">stock.count.config.list.view</field>
            <field name="model">stock.count.config</field>
            <field name="arch" type="xml">
                <tree string="Stock Count Conf List">
                    <field name="name" string="Name"/>
                    <field name="pos_config_id"/>
                    <field name="allowed_product_ids" widget="many2many_tags"/>
                    <field name="company_id" optional="hide"/>
                </tree>
            </field>
        </record>

        <!--    Stock Count Configuration form view    -->

        <record id="stock_count_config_form_view" model="ir.ui.view">
            <field name="name">stock.count.config.form.view</field>
            <field name="model">stock.count.config</field>
            <field name="arch" type="xml">
                <form string="Stock Count Config form">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Name"/>
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="pos_config_id"
                                       options="{'no_create_edit': True, 'no_create': True}"
                                       required="1"
                                       domain="[('terminal_type', '=', 'primary')]"/>
                                <field name="allowed_product_ids" widget="many2many_tags" required="1"/>
                            </group>
                            <group>
                                <field name="company_id" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!--   Stock Count Configuration search view     -->

        <record id="stock_count_config_search_view" model="ir.ui.view">
            <field name="name">stock.count.config.search.view</field>
            <field name="model">stock.count.config</field>
            <field name="arch" type="xml">
                <search string="Search Name">
                    <field name="name" string="Name"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Outlet" name="group_by_pos_config_id" domain="[]"
                                context="{'group_by':'pos_config_id'}"/>
                        <filter string="Company" name="group_by_company" domain="[]"
                                context="{'group_by': 'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!--    Stock Count Configuration action     -->

        <record id="action_stock_count_config" model="ir.actions.act_window">
            <field name="name">Stock Count Configuration</field>
            <field name="res_model">stock.count.config</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="stock_count_config_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create New Stock Count Configuration Record.
                </p>
            </field>
        </record>

    </data>
</odoo>

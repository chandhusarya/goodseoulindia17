<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--    Stock Count Approval List view-->

        <record id="stock_count_approvals_list_view" model="ir.ui.view">
            <field name="name">stock.count.approvals.list.view</field>
            <field name="model">stock.count</field>
            <field name="arch" type="xml">
                <tree decoration-muted="state == 'cancel'">
                    <field name="date"/>
                    <field name="name"/>
                    <field name="pos_config_id"/>
                    <field name="location_id"/>
                    <field name="brand_ids" widget="many2many_tags"/>
                    <field name="state"/>
                    <field name="company_id" optional="hide"/>
                </tree>
            </field>
        </record>

        <!--    Stock Count Approvals form view    -->

        <record id="stock_count_approvals_form_view" model="ir.ui.view">
            <field name="name">stock.count.approvals.form.view</field>
            <field name="model">stock.count</field>
            <field name="arch" type="xml">
                <form string="Stock Count form">
                    <header>
                        <button name="action_start" invisible="state != 'draft'" string="Start Inventory" type="object"
                                class="oe_highlight" groups="stock.group_stock_user"/>
                        <button name="action_send_for_approval" invisible="state != 'progress'"
                                string="Send For Approval"
                                type="object"
                                class="oe_highlight" groups="stock.group_stock_user"/>
                        <button name="action_approve" invisible="state != 'send_for_approval' or not is_approve_user"
                                string="Approve"
                                type="object"
                                class="oe_highlight" groups="sarya_stock_count.stock_count_approve_manager_group"/>
                        <button name="action_reject" invisible="state != 'send_for_approval' or not is_approve_user"
                                string="Reject"
                                type="object"
                                class="oe_highlight" groups="sarya_stock_count.stock_count_approve_manager_group"/>
                        <button name="action_validate" invisible="state != 'approved'" string="Validate Inventory"
                                type="object"
                                class="oe_highlight" groups="sarya_stock_count.stock_count_approve_manager_group"/>
                        <button name="action_draft" invisible="state not in ('cancel', 'rejected')"
                                string="Set to Draft"
                                type="object"/>
                        <button name="action_cancel" invisible="state not in ('progress', 'approved')"
                                string="Cancel Inventory"
                                type="object"/>
                        <field name="state" clickable="1" widget="statusbar" statusbar_visible="draft,progress,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" required="1" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="pos_config_id"
                                       options="{'no_create_edit': True, 'no_create': True}"
                                       required="1"
                                       domain="[('terminal_type', '=', 'primary')]"
                                       readonly="state != 'draft'"/>
                                <field name="location_id" domain="[('usage', '=', 'internal')]"
                                       options="{'no_create': True}" required="1"
                                       groups="stock.group_stock_multi_locations" readonly="state != 'draft'"/>
<!--                                <field name="brand_ids" required="1" widget="many2many_tags"-->
<!--                                       options="{'no_create': True}" readonly="state != 'draft'"/>-->
                            </group>
                            <group>
                                <field name="is_approve_user" invisible="1"/>
                                <field name="date"/>
                                <field name="approved_date" invisible="not approved_date"/>
                                <field name="approved_by" invisible="not approved_by"/>
                                <field name="validated_date" invisible="not validated_date"/>
                                <field name="company_id" groups="base.group_multi_company"
                                       options="{'no_create': True}"/>
                            </group>
                        </group>
                        <notebook invisible="state == 'draft'">
                            <page string="Inventory Details">
                                <button name="action_reset_counted_qty" invisible="1"
                                        string="⇒ Set Counted quantities to 0"
                                        type="object" class="oe_link oe_right" groups="stock.group_stock_user"/>
                                <br/>
                                <button name="action_set_is_counted_qty_entered" invisible="1"
                                        string="⇒ Set Is Real Qty Entered As True"
                                        type="object" class="oe_link oe_right" groups="base.group_no_one"/>
                                <field name="line_ids" string="Inventory Details" mode="tree"
                                       readonly="state != 'progress'">
                                    <tree string="Inventory Details"
                                          decoration-info="counted_qty != theoretical_qty"
                                          decoration-danger="theoretical_qty &lt; 0" create="0" delete="0">
                                        <field name="product_name"/>
                                        <field name="product_id" domain="[('type','=','product')]"
                                               readonly="1"
                                               column_invisible="1"
                                               force_save="1"/>
                                        <field name="primary_packaging_id"/>
                                        <field name="location_id" groups="stock.group_stock_multi_locations"
                                               domain="[('usage', '=', 'internal')]" required="1"
                                               readonly="parent.state == 'done'" optional="hide"/>
                                        <field name="opening_qty" force_save="1"/>
                                        <field name="grn_qty" force_save="1"/>
                                        <field name="transfer_in_qty" force_save="1"/>
                                        <field name="transfer_out_qty" force_save="1"/>
                                        <field name="wastage_qty" force_save="1"/>
                                        <field name="adjustment_qty" force_save="1"/>
                                        <field name="sale_qty" force_save="1"/>
                                        <field name="sale_return_qty" force_save="1"/>
                                        <field name="theoretical_qty" force_save="1"/>
                                        <field name="is_counted_qty_entered"/>
                                        <field name="counted_qty" string="Real Quantity"
                                               readonly="parent.state == 'done'"/>
                                        <field name="stock_diff_quantity" force_save="1"/>
                                        <field name="price" string="Unit Price" readonly="1" force_save="1"
                                               column_invisible="1"/>
                                        <field name="state" column_invisible="True"/>
                                    </tree>
                                </field>
                                <h3 class="oe_grey">Notes</h3>
                                <ul class="oe_grey">
                                    <li>Inventory adjustments will be made by comparing the theoretical and the checked
                                        quantities.
                                    </li>
                                    <li>You can delete lines to ignore some products.</li>
                                    <li>If a product is not at the right place, set the checked quantity to 0 and create
                                        a new line with correct location.
                                    </li>
                                </ul>
                            </page>
                        </notebook>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>


        <!--  Stock Count approvals search view     -->

        <record id="stock_count_approvals_search_view" model="ir.ui.view">
            <field name="name">stock.count.approvals.search.view</field>
            <field name="model">stock.count</field>
            <field name="arch" type="xml">
                <search string="Search Name">
                    <field name="name" string="Name"/>
                    <separator/>
                    <group expand="1" string="Group By">
                        <filter string="Status" name="state" domain="[]" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!--    Stock Count Approvals action     -->

        <record id="stock_count_approvals_action" model="ir.actions.act_window">
            <field name="name">Stock Count Approvals</field>
            <field name="res_model">stock.count</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="stock_count_approvals_search_view"/>
            <field name="domain">[('state', 'in', ['send_for_approval', 'approved', 'done'])]</field>
            <field name="context">{'create':False, 'delete': False, 'search_default_Waiting_approval':1}</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('stock_count_approvals_list_view')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('stock_count_approvals_form_view')}),
                         ]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create New Stock Count Record.
                </p>
            </field>
        </record>

    </data>
</odoo>

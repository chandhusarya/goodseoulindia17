<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="pos_config_view_form_inherited" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherited</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@id='restaurant_on_create']" position="before">
                <div id="stock_count_approve_manager_ids" class="row mt16 o_settings_container">
                    <setting>
                           <field name="stock_count_approve_manager_ids" widget="many2many_tags" options="{'no_create_edit': True, 'no_create': True}" domain="[('company_id', '=', company_id)]"/>
                    </setting>
                </div>
            </xpath>
        </field>
    </record>

</odoo>

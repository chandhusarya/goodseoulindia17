<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Stock Count Approve Manager Group -->
        <record id="stock_count_approve_manager_group" model="res.groups">
            <field name="name">Stock Count Approve Manager</field>
        </record>

        <!--        Stock Count user, manager rule-->
        <record id="stock_count_user" model="ir.rule">
            <field name="name">Stock Count User</field>
            <field name="model_id" ref="sarya_stock_count.model_stock_count"/>
            <field name="domain_force">[('pos_config_id','in',user.get_allowed_pos_for_current_company().ids)]
            </field>
            <field name="groups"
                   eval="[(4,ref('point_of_sale.group_pos_user')), (4,ref('sarya_pos_custom.pos_manager_group'))]"/>
        </record>

        <!--        stock count admin rule-->
        <record id="stock_count_manager" model="ir.rule">
            <field name="name">Stock Count Manager</field>
            <field name="model_id" ref="sarya_stock_count.model_stock_count"/>
            <field name="domain_force">[]</field>
            <field name="groups"
                   eval="[(4,ref('point_of_sale.group_pos_manager'))]"/>
        </record>

        <!--        Stock Count line user, manager rule-->
        <record id="stock_count_user" model="ir.rule">
            <field name="name">Stock Count line User</field>
            <field name="model_id" ref="sarya_stock_count.model_stock_count"/>
            <field name="domain_force">[('pos_config_id','in',user.get_allowed_pos_for_current_company().ids)]
            </field>
            <field name="groups"
                   eval="[(4,ref('point_of_sale.group_pos_user')), (4,ref('sarya_pos_custom.pos_manager_group'))]"/>
        </record>

        <!--        stock count admin rule-->
        <record id="stock_count_manager" model="ir.rule">
            <field name="name">Stock Count line Manager</field>
            <field name="model_id" ref="sarya_stock_count.model_stock_count"/>
            <field name="domain_force">[]</field>
            <field name="groups"
                   eval="[(4,ref('point_of_sale.group_pos_manager'))]"/>
        </record>

    </data>
</odoo>
